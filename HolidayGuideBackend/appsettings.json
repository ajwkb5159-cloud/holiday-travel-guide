{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SQLite": "Data/holiday.db"
  },
  "Update": {
    "Token": "dev-only-token-change-me",
    "BusyDuringUpdate": true,
    "BusyWhenEmpty": true,
    "StaleThresholdDays": 40
  },
  "Ai": {
    "Enabled": false,
    "BaseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
    "ApiKey": "",
    "Model": "qwen-flash",
    "DailyIpQuota": 10,
    "GlobalDailyCap": 500,
    "RetrieveTopK": 6,
    "MaxConcurrent": 3
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5099"
      }
    }
  }
}
