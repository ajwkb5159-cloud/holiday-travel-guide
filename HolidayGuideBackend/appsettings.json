{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SQLite": "Data/holiday.db"
  },
  "Update": {
    "Token": "dev-only-token-change-me",
    "BusyDuringUpdate": true,
    "BusyWhenEmpty": true,
    "StaleThresholdDays": 40
  },
  "Ai": {
    "Enabled": false,
    "BaseURL": "https://opencode.ai/zen/go/v1/chat/completions",
    "ApiKey": "",
    "ApiKeyFile": "",
    "Model": "deepseek-v4.1-flash",
    "MaxTokens": 3000,
    "Temperature": 0.7,
    "TimeoutSeconds": 120,
    "SendReasoningContent": false,
    "SessionId": "",
    "ExtraBodyJson": "",
    "QuotaEnabled": false,
    "HistoryMaxTurns": 500,
    "HistoryMaxChars": 1500000,
    "HistoryPerMessageChars": 50000,
    "DailyIpQuota": 10,
    "GlobalDailyCap": 500,
    "RetrieveTopK": 6,
    "MaxConcurrent": 3
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5099"
      }
    }
  }
}
