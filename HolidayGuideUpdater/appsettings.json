{
  "Backend": {
    "BaseUrl": "http://127.0.0.1:5099",
    "UpdateToken": "dev-only-token-change-me"
  },
  "Updater": {
    "DataDir": "data",
    "BatchSize": 150,
    "BatchDelayMs": 800,
    "RunHour": 3,
    "RunMinute": 0,
    "MaxRetries": 3,
    "RetryBaseDelayMs": 1000,
    "BeginRetryCount": 3,
    "BeginRetryDelaySec": 30,
    "CatchUpOnStart": true,
    "CatchUpRetryCount": 3,
    "CatchUpRetryDelaySec": 30,
    "CatchUpStartupDelaySec": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
